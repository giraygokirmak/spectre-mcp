# spectre-mcp hesap bilgileri — BU DOSYAYI GIT'E KOMITLEMEYIN
# x.com hesabinin auth_token ve ct0 cookie degerleri
# (DevTools -> Application -> Cookies -> https://x.com)

SPECTRE_USERNAME=giraygokirmak
SPECTRE_AUTH_TOKEN=
SPECTRE_CT0=

# Opsiyonel: tum istekler icin cikis proxy'si (orn. http://user:pass@host:port)
# SPECTRE_PROXY=

# Opsiyonel: HTTP dinleme adresi/portu (compose tarafinda 0.0.0.0:7001 zaten ayarli)
# SPECTRE_HTTP_HOST=0.0.0.0
# SPECTRE_HTTP_PORT=7001
